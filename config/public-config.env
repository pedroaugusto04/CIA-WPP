# PUBLIC CONFIGURATION: this file is committed to a public repository.
# Never put access tokens, verification secrets, passwords, or private URLs here.
# Servidor e Meta
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
WEBHOOK_LOG_PAYLOAD_SHAPE=false
WEBHOOK_PATHS='["/","/webhook"]'
META_GRAPH_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=1326117990595221
META_REQUEST_TIMEOUT_MS=10000

# Estado técnico: não guarda telefone em texto, perfil ou respostas pessoais.
# Use um novo STATE_FILE: arquivos do formulário antigo são incompatíveis.
STATE_FILE=./data/sessions.json
SESSION_TTL_SECONDS=86400
DEDUPLICATION_TTL_SECONDS=86400
DEDUPLICATION_LIMIT=5000
SESSION_CLEANUP_INTERVAL_SECONDS=3600
OUTBOUND_MONTHLY_LIMIT=1000
OUTBOUND_SHORT_LIMIT=5
OUTBOUND_SHORT_WINDOW_SECONDS=60
OUTBOUND_SHORT_LIMIT_MESSAGE="Recebemos várias mensagens em pouco tempo. Para que a equipe do CIA consiga acompanhar sua conversa com atenção, aguarde alguns minutos e tente novamente."

# Comandos de navegação (funcionam fora do atendimento humano).
BOT_MENU_COMMANDS=["menu","inicio"]
BOT_HUMAN_COMMANDS='["atendente","falar com atendente","falar com a equipe","conversar com alguém"]'
# Retomada imediata disponível por comando do usuário; após 24h inativo, retorna automaticamente.
BOT_RESUME_ENABLED=true
BOT_RESUME_COMMAND="menu"

BOT_MENU_BUTTON="Ver opções"
BOT_MENU_SECTION="Atendimento"
PROFILE_BUTTON="Escolher perfil"
PROFILE_SECTION="Seu perfil"
FAQ_BUTTON="Ver dúvidas"
FAQ_SECTION="Dúvidas frequentes"
BOT_MENU_MESSAGE="Olá! Você está no atendimento do CIA – Centro de Integração Autista de Ipatinga. Como podemos ajudar? Toque em Ver opções para escolher um assunto."
BOT_INVALID_OPTION_MESSAGE="Não consegui identificar essa opção. Selecione um item da lista ou escreva “menu” para voltar ao início."
BOT_REPEATED_INVALID_OPTION_MESSAGE="Ainda não identifiquei a opção. Escolha um item da lista ou escreva “atendente” para falar com a equipe."
BOT_STALE_SELECTION_MESSAGE="Essa opção é de um menu anterior. Confira as opções atuais e escolha novamente."
BOT_UNSUPPORTED_MESSAGE="Não consigo ler esse tipo de mensagem por aqui. Use as opções abaixo ou escreva “atendente” para falar com a equipe."
BOT_NAVIGATION_MESSAGE="Escolha uma pergunta ou selecione “Voltar ao menu” na lista."
BOT_HUMAN_MESSAGE="A equipe continuará o atendimento por esta conversa quando estiver disponível. Você pode deixar sua mensagem aqui. O bot ficará pausado durante o atendimento e voltará ao menu após 24 horas sem mensagens de nenhum lado. Se quiser voltar antes, escreva “menu”."
BOT_RESOURCE_UNAVAILABLE_MESSAGE="O link ainda não está disponível neste atendimento. A equipe poderá orientar você por aqui."

# Preencha os links oficiais abaixo; vazios encaminham para a equipe.
PARENTS_GROUP_FORM_URL=https://forms.gle/XuwNxRD4HNHJhRPh7
PARENTS_GROUP_MESSAGE="Para solicitar entrada no grupo de pais e familiares, é necessário preencher o formulário de cadastro. A equipe confere as informações e faz a inclusão manualmente."
TEATIVO_WAITLIST_URL=https://docs.google.com/forms/d/e/1FAIpQLSfDrZ4kUG7lhkEEW-PWyY-mMmfg0Sdd9TBR_6qxqZXEUI5HWA/viewform
